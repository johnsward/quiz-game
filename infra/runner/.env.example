# Copy to infra/runner/.env and fill in.
#
# GITHUB_REPO_URL: repo the runner registers against.
# GITHUB_RUNNER_TOKEN: short-lived (~1h) token from
#   Repo -> Settings -> Actions -> Runners -> New self-hosted runner.
# RUNNER_WORK_DIR: ABSOLUTE HOST path; mounted at the same path in the
#   container (required for docker-outside-of-docker bind mounts).
GITHUB_REPO_URL=https://github.com/yourname/quiz-game
GITHUB_RUNNER_TOKEN=paste-a-fresh-token-here
RUNNER_NAME=quiz-runner
RUNNER_WORK_DIR=/Users/yourname/quiz-runner-work
